{
  "name": "millenium",
  "version": "1.0.0",
  "description": "StumbleCups Backend Exploiter.",
  "main": "start.js",
  "scripts": {
    "build": "echo 'No build needed - using start.js'",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:all": "npm run build:frontend && npm run build",
    "setup": "cd frontend && npm install && node --max-old-space-size=1200 node_modules/.bin/next build && cd .. && node scripts/start.js",
    "start": "node start.js",
    "dev": "ts-node Source/index",
    "dev:watch": "nodemon -x ts-node Source/index",
    "check": "tsc --noEmit",
    "lint": "prettier --check ./Source && eslint ./Source --ext .ts",
    "format": "prettier --write ./Source && eslint ./Source --ext .ts --fix"
  },
  "nodemonConfig": {
    "ext": "*.ts,*.json,*.env",
    "ignore": [
      "bin/**",
      "thunder_tests/**"
    ]
  },
  "author": "ash",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.18",
    "@types/node": "^20.19.25",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.1"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.2",
    "colorette": "^2.0.20",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "tsx": "^4.22.3",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "keywords": []
}
